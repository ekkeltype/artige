{
  "subreddits": [
    "Jokes",
    "cleanjokes",
    "dadjokes",
    "3amjokes",
    "puns",
    "unclejokes",
    "dirtyjokes"
  ],
  "limitPerSub": 100,
  "userAgent": "artige/0.3 (+https://github.com/ekkeltype/artige)",
  "minScore": 100,
  "backfill": {
    "enabled": true,
    "chunkDays": 14,
    "maxPagesPerSub": 20,
    "floor": "2010-01-01",
    "start": "2026-05-29"
  },
  "live": {
    "enabled": false,
    "lookback": "2d"
  },
  "translate": {
    "enabled": true,
    "promptFile": "prompts/localize.md",
    "model": "opus",
    "batchSize": 6,
    "maxBudgetUsd": 1.5,
    "timeoutMs": 180000,
    "maxAttempts": 3
  }
}
